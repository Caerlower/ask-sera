# At least one Groq key required. Comma-separated list preferred for failover:
# https://console.groq.com/keys
GROQ_API_KEYS=

# Or numbered extras (GROQ_API_KEY + GROQ_API_KEY_2 … _20 also work):
# GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
# GROQ_API_KEY_6=

# Optional model override (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — Layer 1: live public Sera REST (tokens, markets, fx, health, config)
# Default: mainnet https://api.sera.cx/api/v1
# SERA_NETWORK=mainnet
# SERA_API_BASE overrides only the default network above.
# Cross-network fetches (e.g. Sepolia /config while on mainnet) still use built-in bases
# unless you set SERA_API_BASE_SEPOLIA / SERA_API_BASE_MAINNET.
# SERA_API_BASE=https://api.sera.cx/api/v1
# SERA_API_BASE_SEPOLIA=https://api-testnet.sera.cx/api/v1
# SERA_API_BASE_MAINNET=https://api.sera.cx/api/v1

# Optional — Layer 2: Firecrawl allowlisted official pages (TTL + weekly cron warm)
# https://www.firecrawl.dev/app
# FIRECRAWL_API_KEY=fc-...
# Cache scraped pages (hours). Default 6.
# FIRECRAWL_CACHE_TTL_HOURS=6

# Required when FIRECRAWL_API_KEY is set — secures GET /api/cron/refresh-web
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Optional — Layer 3: Exa for recent announcements on official Sera domains
# (Tweets / @seraprotocol use Firecrawl on https://x.com/seraprotocol — Exa no longer indexes X.)
# https://dashboard.exa.ai/api-keys
# EXA_API_KEY=
# How far back to search (days). Default 14.
# EXA_RECENCY_DAYS=14
