# At least one Groq key required. Comma-separated list preferred for failover:
# https://console.groq.com/keys
GROQ_API_KEYS=

# Or a single key / numbered extras (also supported):
# GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Optional model override (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — live public Sera REST prefetch (tokens, markets, fx, health, config)
# Default: mainnet https://api.sera.cx/api/v1
# SERA_NETWORK=mainnet
# SERA_API_BASE=https://api.sera.cx/api/v1
