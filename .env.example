# Required — Groq API key for chat completions
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional model override (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Live Sera API for Ask Sera tools (tokens, markets, fx, health, config, quote)
# Default: mainnet https://api.sera.cx/api/v1
# SERA_NETWORK=mainnet
# SERA_API_BASE=https://api.sera.cx/api/v1
